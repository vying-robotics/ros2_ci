// Based on Jenkins Basics for Robotics, 8.2 Running Tests in a Jenkins Pipeline
pipeline {
    agent any
    stages {
        stage('Build Docker image') {
            steps {
                // Jenkins workspace = repository root (~/ros2_ws/src in the rosject)
                sh 'docker build -f ros2_ci/Dockerfile -t ros2_ci .'
            }
        }
        stage('Run waypoints tests') {
            steps {
                // Starts FastBot simulation (Gazebo with GUI) and action server,
                // runs the waypoints tests, then shuts Gazebo down
                sh 'echo "DISPLAY=$DISPLAY"'
                sh 'xhost +local:root || true'
                sh 'docker run --rm --name ros2_ci_test -e DISPLAY=$DISPLAY -v /tmp/.X11-unix:/tmp/.X11-unix ros2_ci /run_waypoints_test.sh'
            }
        }
    }
    post {
        always {
            // Remove the test container if the build was aborted
            sh 'docker rm -f ros2_ci_test > /dev/null 2>&1 || true'
        }
    }
}
